          }
        },
        {
          "name": "Edit Review",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"review_text\": \"Good course, could use more examples.\"\n}"
            },
            "url": { "raw": "{{base_url}}/reviews/1", "host": ["{{base_url}}"], "path": ["reviews","1"] },
            "description": "Replace `1` with the review ID from My Reviews. Owner-only."
          }
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/reviews/1", "host": ["{{base_url}}"], "path": ["reviews","1"] },
            "description": "Replace `1` with the review ID. Owner-only."
          }
        }
      ]
    },
    {
      "name": "🔒 Applicant — Quiz & Assessment",
      "item": [
        {
          "name": "My Certifications (eligibility overview)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/certification/my", "host": ["{{base_url}}"], "path": ["certification","my"] },
            "description": "Returns all enrolled courses with assessment eligibility, last attempt status, pass/fail, certificate number, and content completion percentage."
          }
        },
        {
          "name": "Start Quiz",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 1\n}"
            },
            "url": { "raw": "{{base_url}}/quiz/start", "host": ["{{base_url}}"], "path": ["quiz","start"] },
            "description": "Returns 30 random MCQs. 30-minute time limit. If already passed, returns an error with the certificate number."
          }
        },
        {
          "name": "Submit Quiz",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attempt_id\": 1,\n  \"answers\": {\n    \"1\": \"A\",\n    \"2\": \"B\",\n    \"3\": \"C\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/quiz/submit", "host": ["{{base_url}}"], "path": ["quiz","submit"] },
